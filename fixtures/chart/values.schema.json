{
  "type": "object",
  "required": ["image"],
  "additionalProperties": false,
  "properties": {
    "image": {
      "type": "object",
      "required": ["repository", "digest"],
      "additionalProperties": false,
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    },
    "replicas": { "type": "integer", "minimum": 1 },
    "readiness": { "type": "boolean" },
    "startDelay": { "type": "string" },
    "shutdown": { "enum": ["exit", "drain-now", "helper"] },
    "serveAfterTerm": { "type": "string" },
    "drainDeadline": { "type": "string" },
    "spread": { "type": "boolean" },
    "gracePeriod": { "type": "integer", "minimum": 0 },
    "failWork": { "type": "boolean" },
    "workload": { "enum": ["Deployment", "StatefulSet", "DaemonSet"] },
    "denyIngress": { "type": "boolean" },
    "allowProbe": { "type": "boolean" },
    "second": { "type": "boolean" },
    "secondRevision": { "type": "string" },
    "hooks": { "type": "boolean" },
    "hookSleep": { "type": "string" },
    "failAfter": { "type": "string" },
    "failFor": { "type": "string" }
  }
}
